// Filament PBR Shading Model - Standard (exact implementation)
// Matches filament/shaders/src/surface_brdf.fs + surface_shading_model_standard.fs
// Uses GGX D, Smith GGX V, Schlick F with energy compensation

struct PixelParams
{
    float3 diffuseColor;
    float perceptualRoughness;
    float roughness;
    float3 f0;
    float3 dfg;
    float3 energyCompensation;
};

// ---- BRDF: GGX Normal Distribution (Filament exact) ----
float D_GGX(float roughness, float NoH, float3 h)
{
    // Filament: use cross(N,H) for precision on mobile; simplified here
    float oneMinusNoHSquared = 1.0 - NoH * NoH;
    float a = NoH * roughness;
    float k = roughness / (oneMinusNoHSquared + a * a);
    return k * k * (1.0 / 3.141592654);
}

// ---- BRDF: Smith GGX Correlated Visibility (Filament exact) ----
float V_SmithGGXCorrelated(float roughness, float NoV, float NoL)
{
    float a2 = roughness * roughness;
    float GGXV = NoL * sqrt(NoV * NoV * (1.0 - a2) + a2);
    float GGXL = NoV * sqrt(NoL * NoL * (1.0 - a2) + a2);
    return 0.5 / (GGXV + GGXL);
}

// ---- BRDF: Schlick Fresnel (Filament exact) ----
float3 F_Schlick(float3 f0, float f90, float LoH)
{
    return f0 + (f90 - f0) * pow(1.0 - LoH, 5.0);
}

// ---- BRDF: Diffuse lobe (Lambert with energy conservation) ----
float Fd_Lambert()
{
    return 1.0 / 3.141592654;
}

// ---- BRDF: Specular lobe (Filament's isotropicLobe) ----
float3 specularLobe(PixelParams pixel, float NoV, float NoL, float NoH, float LoH, float3 h)
{
    float D = D_GGX(pixel.roughness, NoH, h);
    float V = V_SmithGGXCorrelated(pixel.roughness, NoV, NoL);
    float3 F = F_Schlick(pixel.f0, 1.0, LoH); // f90=1.0 for standard model
    return (D * V) * F;
}

// ---- BRDF: Diffuse lobe (Filament's diffuseLobe) ----
float3 diffuseLobe(PixelParams pixel)
{
    return pixel.diffuseColor * Fd_Lambert();
}

// ---- Surface shading: Filament's surfaceShading (exact) ----
float3 surfaceShading(PixelParams pixel, float3 lightDir, float3 viewDir, float3 N, float occlusion)
{
    float3 H = normalize(viewDir + lightDir);
    
    float NoV = abs(dot(N, viewDir)) + 1e-4;
    float NoL = saturate(dot(N, lightDir));
    float NoH = saturate(dot(N, H));
    float LoH = saturate(dot(lightDir, H));
    
    float3 Fr = specularLobe(pixel, NoV, NoL, NoH, LoH, H);
    float3 Fd = diffuseLobe(pixel);
    
    // Energy compensation (Filament: Fd + Fr * energyCompensation)
    float3 color = Fd + Fr * pixel.energyCompensation;
    
    // Final lighting: color * NoL * occlusion (Filament exact)
    return color * NoL * occlusion;
}

// ---- Energy compensation (Filament: from prefilteredDFG LUT channel y) ----
float3 computeEnergyCompensation(float3 f0, float3 dfg)
{
    return 1.0 + f0 * (1.0 / max(dfg.y, 1e-4) - 1.0);
}
