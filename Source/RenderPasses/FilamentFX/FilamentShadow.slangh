// Filament-style shadow sampling for forward shading (PCF Hard/Low + EVSM/VSM)
// Shared by PBRTOfflineRenderer.3d.slang, ShadowMap.cs.slang

#define SHADOW_TYPE_PCF_HARD 0u
#define SHADOW_TYPE_PCF_LOW  1u
#define SHADOW_TYPE_VSM      2u

// Default EVSM parameters (Filament VsmShadowOptions / half-precision path)
static const float kVsmExponent = 5.2;
static const float kVsmMaxMoment = 65504.0;
static const float kVsmLightBleedReduction = 0.15;
static const float kVsmEpsilonMultiplier = 0.002;

// Select cascade based on view-space depth (world distance from camera)
int selectShadowCascade(float viewSpaceDepth, uint cascadeCount, float4 cascadeSplits)
{
    for (uint i = 0; i < cascadeCount; i++)
    {
        if (viewSpaceDepth < cascadeSplits[i])
            return int(i);
    }
    return int(cascadeCount) - 1;
}

float shadowSample_PCF_Hard(Texture2D<float> shadowMap, SamplerState sampler, float2 shadowUV, float referenceDepth)
{
    float depth = shadowMap.SampleLevel(sampler, shadowUV, 0).r;
    return (referenceDepth >= depth - 1e-5) ? 1.0 : 0.0;
}

// Castano 2013 - 3x3 gaussian PCF (manual taps, matches ShadowMap.cs.slang)
float shadowSample_PCF_Low(Texture2D<float> shadowMap, SamplerState sampler, float2 shadowUV, float referenceDepth, float2 atlasSize)
{
    float2 texelSize = 1.0 / atlasSize;
    float sum = 0.0;
    sum += 4.0 * shadowSample_PCF_Hard(shadowMap, sampler, shadowUV, referenceDepth);
    sum += 2.0 * shadowSample_PCF_Hard(shadowMap, sampler, shadowUV + float2(0, -1) * texelSize, referenceDepth);
    sum += 2.0 * shadowSample_PCF_Hard(shadowMap, sampler, shadowUV + float2(0, 1) * texelSize, referenceDepth);
    sum += 2.0 * shadowSample_PCF_Hard(shadowMap, sampler, shadowUV + float2(-1, 0) * texelSize, referenceDepth);
    sum += 2.0 * shadowSample_PCF_Hard(shadowMap, sampler, shadowUV + float2(1, 0) * texelSize, referenceDepth);
    sum += 1.0 * shadowSample_PCF_Hard(shadowMap, sampler, shadowUV + float2(-1, -1) * texelSize, referenceDepth);
    sum += 1.0 * shadowSample_PCF_Hard(shadowMap, sampler, shadowUV + float2(1, -1) * texelSize, referenceDepth);
    sum += 1.0 * shadowSample_PCF_Hard(shadowMap, sampler, shadowUV + float2(-1, 1) * texelSize, referenceDepth);
    sum += 1.0 * shadowSample_PCF_Hard(shadowMap, sampler, shadowUV + float2(1, 1) * texelSize, referenceDepth);
    return sum / 16.0;
}

// Filament surface_shadowing.fs - Chebyshev upper bound with light bleeding reduction
float chebyshevUpperBound(float2 moments, float depth, float minVariance, float lbrAmount)
{
    if (depth <= moments.x)
        return 1.0;

    float variance = max(moments.y - moments.x * moments.x, minVariance);
    float d = depth - moments.x;
    float pMax = variance / (variance + d * d);
    return saturate((pMax - lbrAmount) / (1.0 - lbrAmount));
}

// Filament evaluateEVSM (positive wrap only; RG moments = exp(c*z), exp(2*c*z))
float evaluateEVSM(float2 moments, float zReceiver, float2 dzduv, float2 texelSize, float c, float lbrAmount)
{
    float2 texelDzduv = dzduv * texelSize;
    float dz2 = dot(texelDzduv, texelDzduv);

    // Remap depth to [-1, 1] then positive exponential wrap
    float depth = zReceiver * 2.0 - 1.0;
    float pw = exp(c * depth);
    float epsilon = kVsmEpsilonMultiplier * (pw * pw);
    float dpwdz = 2.0 * c * pw;
    float pMinVariance = epsilon + 0.25 * (dpwdz * dpwdz) * dz2;
    return chebyshevUpperBound(moments, pw, pMinVariance, lbrAmount);
}

// Receiver-plane depth bias (GDC 2006) - derivatives of light-space depth w.r.t. UV
float2 computeReceiverPlaneDepthBias(float3 position)
{
    float3 duvzDx = ddx(position);
    float3 duvzDy = ddy(position);
    float2x2 duv = float2x2(duvzDx.xy, duvzDy.xy);
    float det = duv[0][0] * duv[1][1] - duv[0][1] * duv[1][0];
    if (abs(det) < 1e-8)
        return float2(0.0, 0.0);
    float2x2 invDuv = float2x2(duv[1][1], -duv[0][1], -duv[1][0], duv[0][0]) / det;
    return mul(invDuv, float2(duvzDx.z, duvzDy.z));
}

float shadowSample_EVSM(
    Texture2D<float2> shadowMoments,
    SamplerState sampler,
    float2 atlasUV,
    float2 cascadeUV,
    float referenceDepth,
    float2 tileSize,
    float c,
    float lbrAmount)
{
    float2 texelSize = 1.0 / tileSize;
    float2 moments = shadowMoments.SampleLevel(sampler, atlasUV, 0).rg;
    float3 position = float3(cascadeUV, referenceDepth);
    float2 dzduv = computeReceiverPlaneDepthBias(position);
    return evaluateEVSM(moments, referenceDepth, dzduv, texelSize, c, lbrAmount);
}

// World position -> shadow visibility [0,1]
float evaluateShadowVisibility(
    float3 worldPos,
    float3 cameraPos,
    uint shadowEnabled,
    uint shadowType,
    uint cascadeCount,
    float shadowBias,
    float4 cascadeSplits,
    float4x4 lightViewProj[4],
    float4 cascadeAtlasRect[4],
    float2 shadowAtlasSize,
    Texture2D<float> shadowMap,
    Texture2D<float2> shadowMoments,
    SamplerState shadowSampler,
    float vsmExponent,
    float vsmLightBleedReduction)
{
    if (shadowEnabled == 0u)
        return 1.0;

    float viewSpaceDepth = length(worldPos - cameraPos);
    int cascade = selectShadowCascade(viewSpaceDepth, cascadeCount, cascadeSplits);

    float4 lightSpacePos = mul(float4(worldPos, 1.0), lightViewProj[cascade]);
    lightSpacePos.xyz /= lightSpacePos.w;

    float2 shadowUV = lightSpacePos.xy * 0.5 + 0.5;
    float4 atlasRect = cascadeAtlasRect[cascade];
    float2 atlasUV = shadowUV * atlasRect.zw + atlasRect.xy;

    if (shadowUV.x < 0.0 || shadowUV.x > 1.0 || shadowUV.y < 0.0 || shadowUV.y > 1.0 || lightSpacePos.z < 0.0 || lightSpacePos.z > 1.0)
        return 1.0;

    float referenceDepth = lightSpacePos.z + shadowBias;

    // Per-cascade tile resolution
    float2 tileSize = shadowAtlasSize * atlasRect.zw;

    if (shadowType == SHADOW_TYPE_VSM)
    {
        float c = (vsmExponent > 0.0) ? vsmExponent : kVsmExponent;
        float lbr = (vsmLightBleedReduction >= 0.0) ? vsmLightBleedReduction : kVsmLightBleedReduction;
        return shadowSample_EVSM(shadowMoments, shadowSampler, atlasUV, shadowUV, referenceDepth, tileSize, c, lbr);
    }

    if (shadowType == SHADOW_TYPE_PCF_LOW)
        return shadowSample_PCF_Low(shadowMap, shadowSampler, atlasUV, referenceDepth, tileSize);
    return shadowSample_PCF_Hard(shadowMap, shadowSampler, atlasUV, referenceDepth);
}

// Filament surface_depth_main.fs - EVSM moment generation for shadow depth pass
// depth: light-space depth in [0, 1]
float2 computeDepthMomentsVSM(float depth, float c, float maxMoment)
{
    float wrappedDepth = depth * 2.0 - 1.0;
    float z = exp(c * wrappedDepth);
    float m1 = z;
    float m2 = z * z;

    float dzdx = ddx(wrappedDepth);
    float dzdy = ddy(wrappedDepth);
    float linearVariance = 0.25 * (dzdx * dzdx + dzdy * dzdy);
    float analyticVariance = c * c * m2 * linearVariance;
    m2 = min(m2 + analyticVariance, maxMoment);
    return float2(m1, m2);
}
