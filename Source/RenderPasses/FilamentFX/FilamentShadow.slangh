// Filament-style shadow sampling for forward shading (PCF Hard + Castano 3x3 Low)
// Shared by PBRTOfflineRenderer.3d.slang and ShadowMap.cs.slang

#define SHADOW_TYPE_PCF_HARD 0u
#define SHADOW_TYPE_PCF_LOW  1u

// Select cascade based on view-space depth (world distance from camera)
int selectShadowCascade(float viewSpaceDepth, uint cascadeCount, float4 cascadeSplits)
{
    for (uint i = 0; i < cascadeCount; i++)
    {
        if (viewSpaceDepth < cascadeSplits[i])
            return int(i);
    }
    return int(cascadeCount) - 1;
}

// D3D depth [0,1]: referenceDepth <= storedDepth means lit
float shadowSample_PCF_Hard(Texture2D<float> shadowMap, SamplerState sampler, float2 shadowUV, float referenceDepth)
{
    float depth = shadowMap.SampleLevel(sampler, shadowUV, 0).r;
    return (referenceDepth <= depth + 1e-5) ? 1.0 : 0.0;
}

// Castano 2013 - 3x3 gaussian PCF (manual taps, matches ShadowMap.cs.slang)
float shadowSample_PCF_Low(Texture2D<float> shadowMap, SamplerState sampler, float2 shadowUV, float referenceDepth, float2 atlasSize)
{
    float2 texelSize = 1.0 / atlasSize;
    float sum = 0.0;
    sum += 4.0 * shadowSample_PCF_Hard(shadowMap, sampler, shadowUV, referenceDepth);
    sum += 2.0 * shadowSample_PCF_Hard(shadowMap, sampler, shadowUV + float2(0, -1) * texelSize, referenceDepth);
    sum += 2.0 * shadowSample_PCF_Hard(shadowMap, sampler, shadowUV + float2(0, 1) * texelSize, referenceDepth);
    sum += 2.0 * shadowSample_PCF_Hard(shadowMap, sampler, shadowUV + float2(-1, 0) * texelSize, referenceDepth);
    sum += 2.0 * shadowSample_PCF_Hard(shadowMap, sampler, shadowUV + float2(1, 0) * texelSize, referenceDepth);
    sum += 1.0 * shadowSample_PCF_Hard(shadowMap, sampler, shadowUV + float2(-1, -1) * texelSize, referenceDepth);
    sum += 1.0 * shadowSample_PCF_Hard(shadowMap, sampler, shadowUV + float2(1, -1) * texelSize, referenceDepth);
    sum += 1.0 * shadowSample_PCF_Hard(shadowMap, sampler, shadowUV + float2(-1, 1) * texelSize, referenceDepth);
    sum += 1.0 * shadowSample_PCF_Hard(shadowMap, sampler, shadowUV + float2(1, 1) * texelSize, referenceDepth);
    return sum / 16.0;
}

// World position -> shadow visibility [0,1]
float evaluateShadowVisibility(
    float3 worldPos,
    float3 cameraPos,
    uint shadowEnabled,
    uint shadowType,
    uint cascadeCount,
    float shadowBias,
    float4 cascadeSplits,
    float4x4 lightViewProj[4],
    float4 cascadeAtlasRect[4],
    float2 shadowAtlasSize,
    Texture2D<float> shadowMap,
    SamplerState shadowSampler)
{
    if (shadowEnabled == 0u)
        return 1.0;

    float viewSpaceDepth = length(worldPos - cameraPos);
    int cascade = selectShadowCascade(viewSpaceDepth, cascadeCount, cascadeSplits);

    float4 lightSpacePos = mul(float4(worldPos, 1.0), lightViewProj[cascade]);
    lightSpacePos.xyz /= lightSpacePos.w;

    float2 shadowUV = lightSpacePos.xy * 0.5 + 0.5;
    float4 atlasRect = cascadeAtlasRect[cascade];
    float2 atlasUV = shadowUV * atlasRect.zw + atlasRect.xy;

    if (atlasUV.x < 0.0 || atlasUV.x > 1.0 || atlasUV.y < 0.0 || atlasUV.y > 1.0)
        return 1.0;

    float referenceDepth = lightSpacePos.z - shadowBias;

    // Per-cascade tile resolution for PCF texel size
    float2 tileSize = shadowAtlasSize * atlasRect.zw;

    if (shadowType == SHADOW_TYPE_PCF_LOW)
        return shadowSample_PCF_Low(shadowMap, shadowSampler, atlasUV, referenceDepth, tileSize);
    return shadowSample_PCF_Hard(shadowMap, shadowSampler, atlasUV, referenceDepth);
}
